+def emit_health_diagnostic(phase, attempt, predicate, result, http_status=None, error=None, reason='OK'):
+    # Only fixed fields reach the existing journal; output failure cannot affect health.
+    try:
+        if (type(phase) is not str or phase not in ('readiness', 'final-health')
+                or (phase == 'readiness' and (type(attempt) is not int or not 1 <= attempt <= 30))
+                or (phase == 'final-health' and attempt is not None)
+                or type(predicate) is not str or predicate not in ('LOCALHOST_ENGINE_HEALTH', 'DEV_HOMEPAGE_HEALTH')
+                or type(result) is not str or result not in ('PASS', 'FAIL')):
+            return
+        exception_class = None
+        if error is not None:
+            # Class labels are fixed base families, never attacker-controlled names/messages.
+            exception_class = 'Exception'
+            if isinstance(error, urllib.error.HTTPError):
+                exception_class = 'HTTPError'; reason = 'HTTP_ERROR'; http_status = error.code
+            elif isinstance(error, (TimeoutError, socket.timeout)):
+                exception_class = 'TimeoutError' if isinstance(error, TimeoutError) else 'socket.timeout'
+                reason = 'TIMEOUT'
+            elif isinstance(error, urllib.error.URLError):
+                exception_class = 'URLError'
+                reason = 'TIMEOUT' if isinstance(error.reason, (TimeoutError, socket.timeout)) else 'URL_ERROR'
+            elif isinstance(error, json.JSONDecodeError):
+                exception_class = 'JSONDecodeError'; reason = 'INVALID_JSON'
+            elif isinstance(error, OSError):
+                exception_class = 'OSError'; reason = 'NETWORK_OR_OS_ERROR'
+            else:
+                for kind, label in ((RuntimeError, 'RuntimeError'), (AttributeError, 'AttributeError'),
+                                    (TypeError, 'TypeError'), (ValueError, 'ValueError')):
+                    if isinstance(error, kind):
+                        exception_class = label
+                        break
+        if type(reason) is not str or reason not in ('OK', 'HTTP_ERROR', 'TIMEOUT', 'URL_ERROR', 'INVALID_JSON',
+                                                     'IDENTITY_MISMATCH', 'NON_200_STATUS', 'NETWORK_OR_OS_ERROR',
+                                                     'UNEXPECTED_EXCEPTION'):
+            return
+        if type(http_status) is not int or not 100 <= http_status <= 599:
+            http_status = None
+        event = {'event': 'gcreation_health_diagnostic',
+                 'timestamp_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
+                 'phase': phase, 'attempt': attempt, 'predicate': predicate, 'result': result,
+                 'http_status': http_status, 'exception_class': exception_class, 'reason': reason}
+        line = 'GCREATION_HEALTH_DIAG ' + json.dumps(event, sort_keys=True, separators=(',', ':'))
+        if len(line) <= 511:  # ASCII-only schema; includes the newline in the 512-byte bound.
+            print(line, flush=True)
+    except Exception:
+        pass
+
+
+def health(phase='final-health', attempt=None):
+    http_status = None; reason = 'UNEXPECTED_EXCEPTION'
+    try:
+        opener = urllib.request.build_opener(NoRedirect())
+        with opener.open('http://127.0.0.1:3101/health', timeout=10) as response:
+            data = json.load(response)
+            http_status = response.status
+            if http_status != 200 or data.get('service') != 'gcreation-performance' or data.get('environment') != 'development':
+                reason = 'NON_200_STATUS' if http_status != 200 else 'IDENTITY_MISMATCH'
+                raise RuntimeError('Internal health failed')
+    except Exception as error:
+        emit_health_diagnostic(phase, attempt, 'LOCALHOST_ENGINE_HEALTH', 'FAIL', http_status, error, reason)
+        raise
+    emit_health_diagnostic(phase, attempt, 'LOCALHOST_ENGINE_HEALTH', 'PASS', http_status)
+    http_status = None; reason = 'UNEXPECTED_EXCEPTION'
+    try:
+        with opener.open('https://dev.gcreation.agency/', timeout=15) as response:
+            http_status = response.status
+            if http_status != 200:
+                reason = 'NON_200_STATUS'
+                raise RuntimeError('DEV website health failed')
+    except Exception as error:
+        emit_health_diagnostic(phase, attempt, 'DEV_HOMEPAGE_HEALTH', 'FAIL', http_status, error, reason)
+        raise
+    emit_health_diagnostic(phase, attempt, 'DEV_HOMEPAGE_HEALTH', 'PASS', http_status)

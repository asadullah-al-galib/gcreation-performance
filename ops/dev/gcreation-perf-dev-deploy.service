[Unit]
Description=Fixed-path gCreation DEV deploy controller (human-installed)
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/lib/gcreation-perf-dev/deploy-dev.sh
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gcreation-perf-dev /home/codexperf/projects/gcreation-performance/.ops /var/www/vhosts/gcreation.agency/dev.gcreation.agency/wp-content/plugins
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

# HUMAN: DEV domain only, Plesk > dev.gcreation.agency > Apache & nginx settings.
# Engine authenticates every route except /health. Secret stays on the WP server;
# customers use the nonce/session-protected WordPress gateway.
location /perf-engine/ {
    proxy_pass http://127.0.0.1:3101/;
    proxy_set_header Host $host;
    proxy_set_header X-Engine-Secret $http_x_engine_secret;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_buffering off;
    proxy_cache off;
    add_header X-Accel-Buffering no always;
    add_header Cache-Control "no-store" always;
}

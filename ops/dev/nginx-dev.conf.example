# HUMAN: DEV domain only, Plesk > dev.gcreation.agency > Apache & nginx settings
# Public health only. Customer operations travel through the authorized WP gateway.
location = /perf-engine/health {
    proxy_pass http://127.0.0.1:3101/health;
    proxy_set_header Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_buffering off;
    proxy_cache off;
}
# Authenticated server APIs/SSE remain loopback-only. If a future browser SSE
# gateway is added, it must validate tokens first and use these transport settings:
# proxy_buffering off; proxy_cache off; proxy_read_timeout 180s;
# add_header X-Accel-Buffering no;
location /perf-engine/ { return 404; }

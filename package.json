{
  "name": "gcreation-performance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "format:check": "prettier --check apps packages tests wordpress/gcreation-performance/*.js *.md *.json",
    "format": "prettier --write apps packages tests wordpress/gcreation-performance/*.js *.md *.json",
    "lint": "eslint apps packages tests && python3 tests/test_deployment_kit.py && php -l wordpress/gcreation-performance/gcreation-performance.php && php tests/wordpress-integration.php && bash -n ops/dev/install-root.sh && sh -n ops/dev/deploy-dev.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/audit-service/src/main.js",
    "lint:ts": "eslint apps packages tests"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "lighthouse": "13.5.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.7.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
